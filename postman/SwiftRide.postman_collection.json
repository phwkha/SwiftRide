  "item": [
    {
      "name": "01. Authentication & Identity",
      "description": "Các API xác thực danh tính, cấp phát và làm mới JWT Bearer Token qua API Gateway.",
      "item": [
        {
          "name": "01. Login as Rider",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('rider_token', json.data.accessToken);",
                  "        pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
                  "        pm.collectionVariables.set('rider_id', json.data.user.id);",
                  "        console.log('Saved Rider Token: ' + json.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rider@swiftride.vn\",\n  \"password\": \"Password123!\",\n  \"role\": \"Rider\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập với tài khoản khách hàng mặc định (rider@swiftride.vn). Script tự động lưu accessToken vào biến collection `rider_token`."
          }
        },
        {
          "name": "02. Login as Driver 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('driver_token', json.data.accessToken);",
                  "        pm.collectionVariables.set('driver_id', json.data.user.id);",
                  "        console.log('Saved Driver Token: ' + json.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"driver1@swiftride.vn\",\n  \"password\": \"Password123!\",\n  \"role\": \"Driver\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập với tài khoản tài xế 1 (driver1@swiftride.vn). Script tự động lưu accessToken vào biến collection `driver_token`."
          }
        },
        {
          "name": "03. Get Current User Profile (/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            },
            "description": "Lấy thông tin người dùng hiện tại dựa trên JWT Token đính kèm."
          }
        },
        {
          "name": "04. Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.accessToken) {",
                  "        pm.collectionVariables.set('rider_token', json.data.accessToken);",
                  "        pm.collectionVariables.set('refresh_token', json.data.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh"]
            },
            "description": "Làm mới Access Token khi token cũ hết hạn bằng Refresh Token."
          }
        }
      ]
    },
    {
      "name": "02. Matching & Pricing",
      "description": "Các API tính giá linh hoạt và tìm kiếm tài xế lân cận dựa trên MongoDB Geo-spatial.",
      "item": [
        {
          "name": "05. Calculate Trip Quote",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.quoteId) {",
                  "        pm.collectionVariables.set('quote_id', json.data.quoteId);",
                  "        console.log('Saved Quote ID: ' + json.data.quoteId);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLatitude\": 10.7769,\n  \"pickupLongitude\": 106.7009,\n  \"pickupAddress\": \"Chợ Bến Thành, Quận 1, TP.HCM\",\n  \"dropoffLatitude\": 10.7829,\n  \"dropoffLongitude\": 106.6989,\n  \"dropoffAddress\": \"Nhà thờ Đức Bà, Quận 1, TP.HCM\",\n  \"vehicleType\": \"Bike\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/matching/quote",
              "host": ["{{base_url}}"],
              "path": ["api", "matching", "quote"]
            },
            "description": "Tính toán cước phí ước tính theo khoảng cách, thời gian và hệ số nhu cầu. Script tự động lưu `quote_id`."
          }
        },
        {
          "name": "06. Find Nearby Drivers",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
