{
  "info": {
    "_postman_id": "41a94473-530b-4740-8239-0ca946276c70",
    "name": "SwiftRide - APIs Only",
    "description": "Danh sách API để gọi thủ công: mỗi operation có đúng một request mẫu, không có ca kiểm thử âm hay assertion. Import cùng SwiftRide.postman_environment.json. Dùng một request login cho cả Rider và Driver bằng cách đổi login_email/login_role ở Variables của collection. Token/ID được tự lưu vào environment. Không Run toàn bộ như kịch bản E2E: reject/cancel là nhánh thay thế, thanh toán thủ công chỉ dùng khi cần. Collection kiểm thử đầy đủ vẫn nằm trong SwiftRide.postman_collection.json.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{rider_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "login_email",
