# SwiftRide Environment Configuration Template
# Copy this file to .env and replace the placeholder values with actual secure secrets.

# SQL Server Configuration (MatchingService & TripService)
MSSQL_SA_PASSWORD=ChangeMe_StrongPassword123!

# PostgreSQL Configuration (PaymentService)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_PostgresPassword123!
POSTGRES_DB=payments_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Authentication & Security
SWIFTRIDE_JWT_SECRET=ChangeMe_SuperSecretKey_AtLeast32BytesLong!
SWIFTRIDE_JWT_ISSUER=SwiftRide.Auth
SWIFTRIDE_JWT_AUDIENCE=SwiftRide.ApiGateway

# OpenTelemetry Exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=SwiftRide
