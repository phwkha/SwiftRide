    {
      "name": "05. Payments & Accounts",
      "item": [
        {
          "name": "POST /api/payments/process",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/payments/process",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payments",
                "process"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{trip_id}}\",\n  \"riderId\": \"{{rider_id}}\",\n  \"driverId\": \"{{driver_id}}\",\n  \"amount\": {{estimated_fare}},\n  \"paymentMethod\": \"Wallet\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Chỉ gọi khi cần thanh toán thủ công/PaymentPending. Trả khách đã tự thanh toán qua RabbitMQ thì không gọi lại. Key được giữ nguyên cho cùng trip_id; transaction_id được lưu khi thành công."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tripId = pm.environment.get('trip_id');",
                  "if (!tripId) throw new Error('Set trip_id first.');",
                  "if (!pm.environment.get('idempotency_key') || pm.environment.get('payment_key_trip_id') !== tripId) {",
                  " pm.environment.set('idempotency_key', 'manual_' + tripId);",
                  " pm.environment.set('payment_key_trip_id', tripId);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) pm.environment.set('transaction_id', pm.response.json().data.transactionId);"
                ]
              }
            }
          ]
        },
