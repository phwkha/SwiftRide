{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "SwiftRide-JWT-Secret-Key-2026-SuperSecure-256Bits!",
    "Issuer": "SwiftRide.Gateway",
    "Audience": "SwiftRide.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174",
      "http://10.0.2.2:5000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "trip-root-route": {
        "ClusterId": "trip-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/trips"
        }
      },
      "trip-route": {
        "ClusterId": "trip-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/trips/{**catch-all}"
        }
      },
      "trip-hub-root-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/hubs/trips"
        }
      },
      "trip-hub-route": {
        "ClusterId": "trip-cluster",
        "Match": {
          "Path": "/hubs/trips/{**catch-all}"
        }
      },
      "matching-root-route": {
        "ClusterId": "matching-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/matching"
        }
      },
      "matching-route": {
        "ClusterId": "matching-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/matching/{**catch-all}"
        }
      },
      "drivers-root-route": {
        "ClusterId": "matching-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/drivers"
        }
      },
      "drivers-route": {
        "ClusterId": "matching-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/drivers/{**catch-all}"
        }
      },
      "payment-root-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/payments"
        }
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "payment-tokens-root-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/payment-tokens"
        }
      },
      "payment-tokens-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/payment-tokens/{**catch-all}"
        }
      },
      "accounts-root-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/accounts"
        }
      },
      "accounts-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "trip-driver-accept-alias": {
        "ClusterId": "trip-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/trips/{id}/driver-accept"
        },
        "Transforms": [
          { "PathPattern": "/api/trips/{id}/accept" },
          {
            "HttpMethodChange": "POST",
            "Set": "PUT"
          }
        ]
      },
      "trip-pickup-alias": {
        "ClusterId": "trip-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/trips/{id}/pickup"
        },
        "Transforms": [
          { "PathPattern": "/api/trips/{id}/pick-up" },
          {
            "HttpMethodChange": "POST",
            "Set": "PUT"
          }
        ]
      },
      "trip-dropoff-alias": {
        "ClusterId": "trip-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/trips/{id}/dropoff"
        },
        "Transforms": [
          { "PathPattern": "/api/trips/{id}/drop-off" },
          {
            "HttpMethodChange": "POST",
            "Set": "PUT"
          }
        ]
      },
      "payments-refund-alias": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/payments/{id}/refund"
        },
        "Transforms": [
          { "PathPattern": "/api/payments/{id}/refund" }
        ]
      },
      "match-alias": {
        "ClusterId": "matching-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/match"
        },
        "Transforms": [
          { "PathSet": "/api/matching/find-drivers" }
        ]
      },
      "quote-alias": {
        "ClusterId": "matching-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/quote"
        },
        "Transforms": [
          { "PathSet": "/api/matching/quote" }
        ]
      },
      "payments-alias": {
        "ClusterId": "payment-cluster",
        "Order": 1,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/payments"
        },
        "Transforms": [
          { "PathSet": "/api/payments/process" }
        ]
      },
      "trips-root-alias": {
        "ClusterId": "trip-cluster",
        "Order": 2,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/trips"
        },
        "Transforms": [
          { "PathSet": "/api/trips" }
        ]
      },
      "trips-sub-alias": {
        "ClusterId": "trip-cluster",
        "Order": 3,
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/trips/{**remainder}"
        },
        "Transforms": [
          { "PathPattern": "/api/trips/{**remainder}" }
        ]
      }
    },
    "Clusters": {
      "trip-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "matching-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5248"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5114"
          }
        }
      }
    }
  }
}
