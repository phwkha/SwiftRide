                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/drivers/{{driver_id}}/location",
              "host": ["{{base_url}}"],
              "path": ["api", "drivers", "{{driver_id}}", "location"]
            },
            "description": "Khách hàng tra cứu vị trí thời gian thực của tài xế."
          }
        }
      ]
    },
    {
      "name": "03. Trip Lifecycle",
      "description": "Các API quản lý vòng đời chuyến đi theo State Machine: Requested -> DriverAccepted -> EnRoute -> PickedUp -> DroppedOff -> Completed / Cancelled.",
      "item": [
        {
          "name": "10. Create Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('trip_id', json.data.id);",
                  "        console.log('Saved Trip ID: ' + json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quoteId\": \"{{quote_id}}\",\n  \"pickupLatitude\": 10.7769,\n  \"pickupLongitude\": 106.7009,\n  \"pickupAddress\": \"Bến Thành, Quận 1\",\n  \"dropoffLatitude\": 10.7829,\n  \"dropoffLongitude\": 106.6989,\n  \"dropoffAddress\": \"Nhà thờ Đức Bà, Quận 1\",\n  \"distanceKm\": 2.5,\n  \"estimatedDurationMinutes\": 8,\n  \"estimatedFare\": 35000,\n  \"vehicleType\": \"Bike\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trips",
              "host": ["{{base_url}}"],
              "path": ["api", "trips"]
            },
            "description": "Tạo chuyến đi mới ở trạng thái Requested (chờ xác nhận giá). Script tự động lưu `trip_id`."
          }
        },
        {
          "name": "11. Confirm Quote (Find Drivers)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/confirm-quote",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "confirm-quote"]
            },
            "description": "Khách hàng chốt báo giá. Kích hoạt Outbox Event `TripRequestedEvent` để Matching Service bắt đầu tìm xe."
          }
        },
        {
          "name": "12. Get Active Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/active",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "active"]
            },
            "description": "Lấy thông tin chuyến đi đang diễn ra dở dang của User (dùng khi mở lại app)."
          }
        },
        {
          "name": "13. Get Trip by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}"]
            },
            "description": "Tra cứu chi tiết cuốc xe theo Trip ID."
          }
        },
        {
          "name": "14. Driver Accept Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/accept",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "accept"]
            },
            "description": "Tài xế nhấn đồng ý nhận cuốc. Trạng thái chuyển sang DriverAccepted."
          }
        },
        {
          "name": "15. Driver Reject Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Tài xế đang bận đổ xăng\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/reject",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "reject"]
            },
            "description": "Tài xế từ chối cuốc. Hệ thống ghi nhận và tự động tìm tài xế khác phù hợp."
          }
        },
        {
          "name": "16. Driver Start Route (Arriving)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/start-route",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "start-route"]
            },
            "description": "Tài xế xuất phát di chuyển đến điểm đón khách."
          }
        },
        {
          "name": "17. Driver Pick Up Passenger",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/pick-up",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "pick-up"]
            },
            "description": "Xác nhận khách đã lên xe. Chuyến đi chuyển sang PickedUp."
          }
        },
        {
          "name": "18. Driver Drop Off (Complete Trip)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"Wallet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/drop-off",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "drop-off"]
            },
            "description": "Trả khách tại đích đến. Tự động phát sinh thanh toán qua RabbitMQ vào PaymentService."
          }
        },
        {
          "name": "19. Cancel Trip",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Khách đổi ý muốn đi phương tiện khác\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/cancel",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "cancel"]
            },
            "description": "Hủy chuyến đi (chỉ hợp lệ khi chuyến đi chưa hoàn tất)."
          }
        }
      ]
    },
    {
      "name": "04. Gateway Aggregation",
      "description": "Endpoint gom dữ liệu chuyến đi + vị trí tài xế theo thời gian thực tại API Gateway.",
      "item": [
        {
          "name": "20. Get Aggregated Trip Overview",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/trips/{{trip_id}}/overview",
              "host": ["{{base_url}}"],
              "path": ["api", "trips", "{{trip_id}}", "overview"]
            },
            "description": "API Aggregation: Gom dữ liệu TripService + GPS MatchingService trong 1 lần gọi (timeout 5s)."
          }
        }
      ]
    },
    {
      "name": "05. Payments & Accounts",
      "description": "Các API thanh toán sổ cái kép (Double-entry Ledger), liên kết nguồn tiền và tra cứu số dư ví.",
      "item": [
        {
          "name": "21. Process Payment (with Idempotency)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "pay-manual-{{$timestamp}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{trip_id}}\",\n  \"riderId\": \"{{rider_id}}\",\n  \"driverId\": \"{{driver_id}}\",\n  \"amount\": 35000,\n  \"paymentMethod\": \"Wallet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/payments/process",
              "host": ["{{base_url}}"],
              "path": ["api", "payments", "process"]
            },
            "description": "Thanh toán thủ công có kèm Idempotency Key (dùng khi cuốc xe ở trạng thái PaymentPending)."
          }
        },
        {
          "name": "22. Refund Transaction (Saga Compensating)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{rider_token}}",
                  "type": "string"
                }
              ]
            },
