  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"password\": \"{{demo_password}}\",\n  \"role\": \"{{login_role}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Đổi login_email và login_role trong Variables của collection để đăng nhập Rider hoặc Driver. Gọi cùng request này lần lượt cho hai tài khoản; token được lưu đúng theo role. demo_password lấy từ environment, khớp .env."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  " const d = pm.response.json().data;",
                  " const role = d.user.role.toLowerCase();",
                  " if (role === 'rider' || role === 'driver') {",
                  "  pm.environment.set(role + '_token', d.accessToken);",
                  "  pm.environment.set(role + '_id', d.user.id);",
                  " }",
                  " if (role === 'rider') pm.environment.set('refresh_token', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/refresh",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Làm mới token Rider; refresh token cũ bị thu hồi."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  " const d = pm.response.json().data;",
                  " pm.environment.set('rider_token', d.accessToken);",
                  " pm.environment.set('refresh_token', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me",
