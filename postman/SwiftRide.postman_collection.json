                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLatitude\": 10.7769,\n  \"pickupLongitude\": 106.7009,\n  \"radiusKm\": 5.0,\n  \"vehicleType\": \"Bike\",\n  \"limit\": 10\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/matching/find-drivers",
              "host": ["{{base_url}}"],
              "path": ["api", "matching", "find-drivers"]
            },
            "description": "Tìm danh sách các tài xế đang rảnh xung quanh tọa độ đón khách."
          }
        },
        {
          "name": "07. Update Driver Availability",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isAvailable\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/drivers/{{driver_id}}/availability",
              "host": ["{{base_url}}"],
              "path": ["api", "drivers", "{{driver_id}}", "availability"]
            },
            "description": "Tài xế bật hoặc tắt trạng thái sẵn sàng đón cuốc xe mới."
          }
        },
        {
          "name": "08. Update Driver GPS Location",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{driver_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 10.7772,\n  \"longitude\": 106.7015,\n  \"bearing\": 90.0,\n  \"speed\": 25.5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/drivers/{{driver_id}}/location",
              "host": ["{{base_url}}"],
              "path": ["api", "drivers", "{{driver_id}}", "location"]
            },
            "description": "Driver App gửi tọa độ GPS định kỳ lên hệ thống."
          }
        },
        {
          "name": "09. Get Driver Location",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
