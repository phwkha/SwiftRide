# SwiftRide Environment Configuration Template
# Local development sample values. Replace secrets before deploying.

# SQL Server Configuration (TripService)
MSSQL_SA_PASSWORD=Password123!

# PostgreSQL Configuration (PaymentService)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=PayDB

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Authentication & Security
SWIFTRIDE_DEMO_PASSWORD=Password123!
SWIFTRIDE_JWT_SECRET=SwiftRide-Local-Demo-JWT-Key-2026-AtLeast32Bytes!
SWIFTRIDE_JWT_ISSUER=SwiftRide.Gateway
SWIFTRIDE_JWT_AUDIENCE=SwiftRide.Client

# OpenTelemetry Exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=SwiftRide
