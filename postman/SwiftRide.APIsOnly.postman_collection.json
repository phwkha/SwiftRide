        {
          "name": "POST /api/payment-tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/payment-tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "payment-tokens"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"Momo\",\n  \"token\": \"tok_momo_sample_1234\",\n  \"isDefault\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Liên kết nguồn thanh toán bằng token; không gửi số thẻ/CVV."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
